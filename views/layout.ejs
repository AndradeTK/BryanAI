<!DOCTYPE html>
<html lang="pt-BR" class="<%= typeof darkMode !== 'undefined' && darkMode ? 'dark' : '' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'BryanAI' %></title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .sidebar-link.active { background-color: rgb(37 99 235); color: white; }
        .dark body { background-color: #111827; color: #f3f4f6; }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 min-h-screen dark:text-gray-100 transition-colors duration-200">
    <div class="flex">
        <!-- Sidebar -->
        <%- include('partials/sidebar') %>

        <!-- Main Content -->
        <main class="flex-1 ml-64">
            <!-- Header -->
            <%- include('partials/header') %>

            <!-- Page Content -->
            <div class="p-6">
                <!-- Alerts -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="mb-4 p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-300 rounded-lg">
                        <%= error %>
                    </div>
                <% } %>
                <% if (typeof success !== 'undefined' && success) { %>
                    <div class="mb-4 p-4 bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-600 text-green-700 dark:text-green-300 rounded-lg">
                        <%= success %>
                    </div>
                <% } %>

                <%- body %>
            </div>
        </main>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>
