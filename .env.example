# Copie para .env e preencha. NUNCA coloque valores reais neste arquivo.

NODE_ENV=development
PORT=3000

# ---------- Banco ----------
# Postgres 17 com a extensão pgvector habilitada no banco.
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/bryanai

# ---------- IA ----------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=cole-sua-chave-aqui
GEMINI_MODEL=gemini-2.5-flash

# ---------- Autenticação ----------
# Segredo de assinatura das sessões. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor invalida todas as sessões ativas.
AUTH_SECRET=gere-um-valor-aleatorio-de-no-minimo-32-caracteres

# Token que a extensão Chrome usa para chamar a API. Gere com o mesmo comando.
# Deve ser colado na aba de configuração da extensão.
EXTENSION_API_TOKEN=gere-outro-valor-aleatorio

# ---------- Armazenamento ----------
# Onde ficam PDFs/DOCX gerados e os documentos enviados. Em produção aponte para
# um diretório FORA do release, senão cada deploy apaga os arquivos.
STORAGE_DIR=./generated

# ---------- Puppeteer ----------
# Caminho do Chrome já instalado no servidor (evita baixar outro a cada deploy).
# PUPPETEER_EXECUTABLE_PATH=/opt/chrome/chrome-linux64/chrome
# Sandbox do Chrome: manter ligado quando o SO já isola o processo.
PUPPETEER_NO_SANDBOX=false

# ---------- Rede ----------
# URL pública, usada para montar links absolutos e validar a origem do login.
APP_URL=http://localhost:3000
